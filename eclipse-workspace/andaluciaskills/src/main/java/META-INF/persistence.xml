<?xml version="1.0" encoding="UTF-8"?>
<persistence version="2.1" xmlns="http://xmlns.jcp.org/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <!-- 1. Nombre de la unidad de persistencia para este proyecto -->
    <persistence-unit name="Competicion" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <properties>
            <!-- 2. Cambia "competicion" por el nombre real de tu esquema/BD -->
            <property name="javax.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/competicion?useSSL=false&amp;serverTimezone=UTC"/>
            <!-- 3. Credenciales de conexión a tu BD -->
            <property name="javax.persistence.jdbc.user" value="root"/>
            <property name="javax.persistence.jdbc.password" value="root"/>
            <property name="javax.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <!-- 4. En el temario se usa "update" -->
            <property name="javax.persistence.schema-generation.database.action" value="update"/>
        </properties>
    </persistence-unit>
</persistence>