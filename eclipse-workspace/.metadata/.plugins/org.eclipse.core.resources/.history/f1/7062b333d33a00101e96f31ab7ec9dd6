package examen3;

import java.util.ArrayList;
import java.util.List;
import java.util.TreeMap;

public class Modelo {
	private TreeMap<Cliente, ArrayList<Pago>> pagosRealizados=new TreeMap<>();

	public Modelo() {
		super();
	}

	public TreeMap<Cliente, ArrayList<Pago>> getPagosRealizados() {
		return pagosRealizados;
	}

	public void setPagosRealizados(TreeMap<Cliente, ArrayList<Pago>> pagosRealizados) {
		this.pagosRealizados = pagosRealizados;
	}

	//TODO
	public boolean contieneCliente(String dni) {
		ArrayList<Pago> clienteDni = pagosRealizados.get(dni);
		
		for (Pago cliente : clienteDni) {
			if(clienteDni.contains(dni)) {
				return true;
			}
		}
		
		return false;
	}

	//TODO
	public void addCliente(Cliente cliente) {
		ArrayList<Pago> listaCliente = pagosRealizados.get(cliente);
		ArrayList<Pago> listaPago = new ArrayList<>();
		
		for (Pago recorridoCliente : listaCliente) {
			if(listaPago == null) {
				listaPago.add(recorridoCliente);
			}
		}
	}

	//TODO
	public boolean removeCliente(String dni) {
		ArrayList<Pago> clienteDni = pagosRealizados.get(dni);
		
		for(Pago cliente : clienteDni) {
			Pago clienteEliminar = null;
			
			if(clienteDni.contains(dni)) {
				clienteEliminar = cliente;
				clienteDni.remove(clienteEliminar);
			}
		}
		
		return false;
	}
	
	public List<Cliente> comboCliente(String cliente) {
		ArrayList<Pago> listaCliente = pagosRealizados.get(cliente);
		List<Cliente> conjunto = new ArrayList<>();
		
		for(Pago recorridoCliente : listaCliente) {
			conjunto.add(recorridoCliente);
		}
		return null;
	}





	
	

}
