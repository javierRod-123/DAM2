package mamiferos;

import java.util.Arrays;

public class Zoologico {
	private Mamifero tMamiferos[];
	private Veterinario tVeterinarios[];

	public Zoologico() {
		this.tVeterinarios = new Veterinario[0];
		this.tMamiferos = new Mamifero[0];
	}

	public Mamifero[] gettMamiferos() {
		return tMamiferos;
	}

	public Veterinario[] gettVeterinarios() {
		return tVeterinarios;
	}

	public void addVeterinario(Veterinario veterinario) {
		this.tVeterinarios = Arrays.copyOf(this.tVeterinarios, this.tVeterinarios.length + 1);
		this.tVeterinarios[this.tVeterinarios.length - 1] = veterinario;
	}

	public void addMamifero(Mamifero mamifero) {
		this.tMamiferos = Arrays.copyOf(tMamiferos, this.tMamiferos.length + 1);
		tMamiferos[this.tMamiferos.length - 1] = mamifero;
	}

	/*
	 * devuelve todos los mam�feros que hayan nacido entre las fechas de inicio y
	 * fin que se pasan como par�metros.
	 */

	public Mamifero[] getMamiferosEntreFechas(Fecha inicio, Fecha fin) {
		int cont = 0;

		for (int i = 0; i < tMamiferos.length; i++) {
			Mamifero m = tMamiferos[i];
			if (m.getDiaNacimiento().compareTo(inicio) >= 0 && m.getDiaNacimiento().compareTo(fin) <= 0) {
				cont++;
			}
		}

		Mamifero tMamiferosEntreFechas[] = new Mamifero[cont];
		int j = 0;

		for (int i = 0; i < tMamiferos.length; i++) {
			Mamifero m = tMamiferos[i];
			if (m.getDiaNacimiento().compareTo(inicio) >= 0 && m.getDiaNacimiento().compareTo(fin) <= 0) {
				tMamiferosEntreFechas[j] = m;
				j++;
			}
		}

		return tMamiferosEntreFechas;
	}

	public int getNVeterinariosMasDe(int minNumNacimientos) {
		int cont[] = new int[tVeterinarios.length];

		for (int i = 0; i < tMamiferos.length; i++) {
			Mamifero m = tMamiferos[i];
			Veterinario asistente = m.getAsistente();

			for (int j = 0; j < tVeterinarios.length; j++) {
				if (tVeterinarios[j] == asistente) {
					cont[j]++;
				}

			}
		}

		int resultado = 0;
		for (int i = 0; i < cont.length; i++) {
			if (cont[i] >= minNumNacimientos) {
				resultado++;
			}
		}

		return resultado;
	}

	public boolean veterinarioPadresEHijo() {
		boolean asistioPadre = false;
		boolean asistioMadre = false;
		
		for (int i = 0; i < tMamiferos.length; i++) {
			Mamifero m = tMamiferos[i];
			Veterinario asistenteHijo = m.getAsistente();
			Mamifero padre = m.getPadre();
			Mamifero madre = m.getMadre();
			
			if (padre != null && padre.getAsistente() == asistenteHijo) {
				asistioPadre = true;
			}
			
			if (madre != null && madre.getAsistente() == asistenteHijo) {
				asistioMadre = true;
			}
		}
		
		if (asistioPadre && asistioMadre) {
			return true;
		}
		
		return false;
	}

	public void ordenarMamiferos() {
		for (int i = 0; i < tMamiferos.length - 1; i++) {
			for (int j = i + 1; j < tMamiferos.length; j++) {
				if (tMamiferos[i].getDiaNacimiento().compareTo(tMamiferos[j].getDiaNacimiento()) > 0) {
					Mamifero aux = tMamiferos[i];
					tMamiferos[i] = tMamiferos[j];
					tMamiferos[j] = aux;
				}
			}
		}
		
		
	}
}
