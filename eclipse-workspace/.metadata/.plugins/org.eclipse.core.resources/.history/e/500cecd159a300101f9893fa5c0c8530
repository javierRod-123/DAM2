				notaPrimerParcial = sc.nextFloat();
				System.out.print("Dime la nota del segundo parcial del alumno " + i + ": ");
				notaSegundoParial = sc.nextFloat();
				System.out.print("Dime la nota del tercer parcial del alumno " + i + ": ");
				notaTercerParcial = sc.nextFloat();

				float notaMedia = notaPrimerParcial + notaSegundoParial + notaTercerParcial / 3;

				if (notaMedia > notaMediaMayor) {
					notaMediaMayor = notaMedia;
					nombreAlumnoMayorNotaMedia = nombreAlumno;
				}
				
				if(notaMedia < 5) {
					contSuspensos++;
				}
				
				if(notaMedia >= 9) {
					sobresalientes = true;
				}

			}
			break;
		case 'C':
			for (int i = 1; i <= 31; i++) {
				System.out.print("Nombre del alumno: ");
				nombreAlumno = sc.next();
				System.out.print("Dime la nota primer parcial del alumno " + i + ": ");
				notaPrimerParcial = sc.nextFloat();
				System.out.print("Dime la nota del segundo parcial del alumno " + i + ": ");
				notaSegundoParial = sc.nextFloat();
				System.out.print("Dime la nota del tercer parcial del alumno " + i + ": ");
				notaTercerParcial = sc.nextFloat();

				float notaMedia = notaPrimerParcial + notaSegundoParial + notaTercerParcial / 3;

				if (notaMedia > notaMediaMayor) {
					notaMediaMayor = notaMedia;
					nombreAlumnoMayorNotaMedia = nombreAlumno;
				}
				
				if(notaMedia < 5) {
					contSuspensos++;
				}
				
				if(notaMedia >= 9) {
					sobresalientes = true;
				}

			}
			break;
		case 'D':
			for (int i = 1; i <= 29; i++) {
				System.out.print("Nombre del alumno: ");
				nombreAlumno = sc.next();
				System.out.print("Dime la nota primer parcial del alumno " + i + ": ");
				notaPrimerParcial = sc.nextFloat();
				System.out.print("Dime la nota del segundo parcial del alumno " + i + ": ");
				notaSegundoParial = sc.nextFloat();
				System.out.print("Dime la nota del tercer parcial del alumno " + i + ": ");
				notaTercerParcial = sc.nextFloat();

				float notaMedia = notaPrimerParcial + notaSegundoParial + notaTercerParcial / 3;

				if (notaMedia > notaMediaMayor) {
					notaMediaMayor = notaMedia;
					nombreAlumnoMayorNotaMedia = nombreAlumno;
				}
				
				if(notaMedia < 5) {
					contSuspensos++;
				}
				
				if(notaMedia >= 9) {
					sobresalientes = true;
				}

			}
			break;
		}
		
		System.out.println("El nombre del alumno con mayor nota media es: "+nombreAlumnoMayorNotaMedia);
		System.out.println("Hay un total de "+contSuspensos+" alumnos suspensos");
		
