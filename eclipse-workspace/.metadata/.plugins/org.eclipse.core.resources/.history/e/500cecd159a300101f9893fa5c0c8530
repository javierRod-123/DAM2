				float notaMedia = notaPrimerParcial + notaSegundoParial + notaTercerParcial / 3;

				if (notaMedia > notaMediaMayor) {
					notaMediaMayor = notaMedia;
					nombreAlumnoMayorNotaMedia = nombreAlumno;
				}
				
				if(notaMedia < 5) {
					contSuspensos++;
				}
				
				if(notaMedia >= 9) {
					sobresalientes = true;
				}

			}
			break;
		case 'B':
			for (int i = 1; i <= 28; i++) {
				System.out.print("Nombre del alumno: ");
				nombreAlumno = sc.next();
