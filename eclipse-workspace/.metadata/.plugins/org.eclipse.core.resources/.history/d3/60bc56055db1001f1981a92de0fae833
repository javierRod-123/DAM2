	// 1
	public static int getIndexOf(String[] tablaString, String elemABuscar, int numElementos) {
		int indice = -1;

		for (int i = 0; i < numElementos && indice == -1; i++) {
			if (tablaString[i] != null && tablaString[i].equals(elemABuscar)) {
				indice = i;
			}
		}

		return indice;
	}
	public static String[] getMatrizSorted(String[] array, int numElementos) {
		String[] arrayOrdenado = Arrays.copyOf(array, numElementos);
		Arrays.sort(arrayOrdenado);
		return arrayOrdenado;
	}

