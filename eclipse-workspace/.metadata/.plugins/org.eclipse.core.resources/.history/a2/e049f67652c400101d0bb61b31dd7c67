	public static float getIndexOf2(int[][] array, int numElemen, int elemBuscar) {
		if (array == null || numElemen <= 0) {
			return -1;
		}

		for (int i = 0; i < numElemen && i < array.length; i++) {
			for (int j = 0; j < array[i].length; j++) {
				if (array[i][j] == elemBuscar) {
					return i; // Devuelve el índice de la fila donde se encontró
