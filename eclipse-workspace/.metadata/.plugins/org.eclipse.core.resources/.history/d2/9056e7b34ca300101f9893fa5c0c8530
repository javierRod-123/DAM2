package tipoExamenCorto;

import java.util.Scanner;

public class CentroEducativo {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		float notaPrimerParcial = 0;
		float notaSegundoParial = 0;
		float notaTercerParcial = 0;

		System.out.println("Introduce la letra del grupo: ");
		char letraGrupo = sc.next().charAt(0);
		
		switch(letraGrupo) {
		case 'A':
			for(int i = 1; i <= 25; i++) {
				System.out.print("Dime la nota primer parcial del alumno "+i+": ");
				notaPrimerParcial = sc.nextFloat();
				System.out.print("Dime la nota del segundo parcial del alumno "+i+": ");
				notaSegundoParial = sc.nextFloat();
				System.out.print("Dime la nota del tercer parcial del alumno "+i+": ");
				notaTercerParcial = sc.nextFloat();
			}
		}
		
		sc.close();
	}

}
