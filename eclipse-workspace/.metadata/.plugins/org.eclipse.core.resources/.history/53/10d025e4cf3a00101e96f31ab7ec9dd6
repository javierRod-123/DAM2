	protected void botonListarTodoPulsado() {

		this.areaBusquedas.setText("");
		for (Cliente c : this.controlador.getModelo().getPagosRealizados().keySet()) {

			this.areaBusquedas.append("  CLIENTE: \n");
			this.areaBusquedas.append("       DNI...: " + c.getDni() + "\n");
			this.areaBusquedas.append("       PAGOS...: \n");

			for (Pago p : this.controlador.getModelo().getPagosRealizados().get(c))
				this.areaBusquedas.append("                       " + p + "\n");
		}

	}



	protected void botonMostrarBusquedaPulsado() {
		if (this.campoDniABuscar.getText().isEmpty())
			this.error("No se puede dejar el nombre vacio");
		else {
			Cliente c=new Cliente(this.campoDniABuscar.getText());
			if (!this.controlador.getModelo().getPagosRealizados().containsKey(c))
				this.error("Ese cliente no esta en el modelo.");
			else {
				ArrayList<Pago> pagosCliente = this.controlador.getModelo().getPagosRealizados().get(c);
				this.areaBusquedas.setText("");
				this.areaBusquedas.append("  CLIENTE: \n");
				this.areaBusquedas.append("       DNI...: " + c.getDni() + "\n");
				this.areaBusquedas.append("       PAGOS...: \n");

				for (Pago p : this.controlador.getModelo().getPagosRealizados().get(c))
					this.areaBusquedas.append("                       " + p + "\n");
			}
			
		}
	}

	protected void botonQuitarContactoPulsado() {
		if (this.campoDni.getText().isEmpty())
			this.error("No se puede dejar el dni vacio");
		else {
			if (!this.controlador.contieneCliente(this.campoDni.getText()))
				this.error("Ese dni no esta en el modelo.");
			else {

				this.controlador.removeCliente(this.campoDni.getText());
				this.mensaje("Cliente borrado.");
			}
		}

	}

	protected void botonLimpiarDatosContacto() {
		this.campoNombre.setEnabled(true);
		this.campoTelefono.setEnabled(true);
		this.campoDni.setEnabled(true);
		this.campoNombre.setText("");
		this.campoTelefono.setText("");
		this.campoDni.setText("");
		this.botonGuardarContacto.setEnabled(true);
		this.botonBorrarContacto.setEnabled(true);
	}

	protected void botonGuardarContactoPulsado() {
		if (this.campoDni.getText().isEmpty() || this.campoNombre.getText().isEmpty()
				|| this.campoTelefono.getText().isEmpty()) {
			this.error("No se pueden dejar campos vacios");
		} else {
			if (this.controlador.contieneCliente(this.campoDni.getText()))
				this.error("Ese cliente ya esta en el modelo.");
			else {

				this.controlador.addCliente(
						new Cliente(this.campoDni.getText(), this.campoNombre.getText(), this.campoTelefono.getText()));
				this.campoDni.setEnabled(false);
				this.campoTelefono.setEnabled(false);
				this.campoNombre.setEnabled(false);
				this.botonGuardarContacto.setEnabled(false);
				this.botonBorrarContacto.setEnabled(false);
				this.campoTelefono.setEnabled(false);
			}
		}
	}


	private void error(String msg) {
		JOptionPane.showMessageDialog(this, msg, "Error", JOptionPane.ERROR_MESSAGE);
	}

	private void mensaje(String msg) {
		JOptionPane.showMessageDialog(this, msg, "Correcto", JOptionPane.INFORMATION_MESSAGE);
	}
