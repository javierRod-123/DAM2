package tiposExamen;

import java.util.Scanner;

public class Ej2 {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int numAlumnos = 0;
		double notaAlumno = 0;
		int contAlumnosMenor8 = 0;
		double suma = 0;
		double mediaCurso = 0;
		double mediaCursoMayor = 0;
		double mediaCursoMenor = 0;
		int contSuspenso = 0;
		int cantidadSuspensosMayor = 0;
		String cursoConMayorSuspensos = "";
		
		System.out.println("Introduce un curso: ");
		String curso = sc.next();
		
		while(!curso.equals("fin")) {
			System.out.println("¿Cuántos alumnos tiene el curso?");
			numAlumnos = sc.nextInt();
			
			for(int i = 0; i <= numAlumnos; i++) {
				System.out.println("Dime la nota del alumno "+i+": ");
				notaAlumno = sc.nextDouble();
				
				suma += notaAlumno;
				
				if(numAlumnos < 8) {
					contAlumnosMenor8++;
				}
				
				mediaCurso = suma / i;
				
				if(mediaCurso > mediaCursoMayor) {
					mediaCursoMayor = mediaCurso;
				} else if(mediaCurso < mediaCursoMenor) {
					mediaCursoMenor = mediaCurso;
				}
				
				if(notaAlumno < 5) {
					contSuspenso++;
				}
				
				if(contSuspenso > cantidadSuspensosMayor) {
					cantidadSuspensosMayor = contSuspenso;
					cursoConMayorSuspensos = curso;
				} else if() {
					
				}
			}
		}
		
		
		
		sc.close();
	}

}
