package tareas;

import java.util.*;


public class Actividad3 {

	public static void main(String[] args) {

		ArrayList<Integer> listaNumeros = new ArrayList<Integer>();
		Random random = new Random();
		for (int i = 0; i < 20; i++) {
			int numRandom = random.nextInt(10);
			listaNumeros.add(numRandom);
			
			int posicion = 0;
			
			while (posicion < listaNumeros.size() && numRandom < listaNumeros.get(posicion)) {
				posicion++;
			}
			
			listaNumeros.add(posicion, numRandom);
		}
	}

}
