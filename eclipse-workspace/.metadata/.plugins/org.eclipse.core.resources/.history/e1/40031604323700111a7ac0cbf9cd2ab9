package examenrepaso;

import java.io.BufferedWriter;
import java.io.FileWriter;
import java.io.IOException;

public class HiloGerenadorNumeros {

	public static void main(String[] args) {
		int numMin = Integer.parseInt(args[0]);
		int numMax = Integer.parseInt(args[1]);
		String nombreFichero = args[2];
		
		try (BufferedWriter bw = new BufferedWriter(new FileWriter(nombreFichero))){
					for (int i = 0; i < numMax; i++) {
			int valorEntero = (int) (Math.floor (Math.random() * (numMax - numMin + 1) + numMax));
			bw.write(valorEntero);
			bw.newLine();
		}
		} catch (IOException e) {
			e.printStackTrace();
		}

	}

}
