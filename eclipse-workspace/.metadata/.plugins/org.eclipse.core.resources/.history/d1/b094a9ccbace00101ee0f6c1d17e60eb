package tarea1OrientadoObjetos;

public class CuentaCorriente {

	int saldo;
	int limiteDescubierto;
	String nombreTitular;
	String dniTitular;

	public CuentaCorriente(String nombre, String dni) {
		this.nombreTitular = nombre;
		this.dniTitular = dni;
		this.saldo = 0;
		this.limiteDescubierto = -50;
	}

	public boolean sacarDinero(int cantidad) {

		if (this.saldo - cantidad >= this.limiteDescubierto) {
			this.saldo -= cantidad;
			System.out.println("Operación realizada. Nuevo saldo: " + this.saldo);
			return true;
		} else {
			System.out.println("Operación rechazada. Saldo insuficiente");
			return false;
		}

	}

	public void ingresarDinero(int cantidad) {
		this.saldo += cantidad;
		System.out.println("Ingreso realizado. Nuevo saldo: " + this.saldo);
	}

	public void mostrarInformacion() {
		System.out.println("Titular: " + this.nombreTitular + " (DNI: " + this.dniTitular + ")");
		System.out.println("Saldo: " + this.saldo);
		System.out.println("Límite de descubierto: " + this.limiteDescubierto);
	}

}
