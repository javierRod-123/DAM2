					}
					
					
				}
				for (int i = 0; i < tabla.length; i++) {
					for (int a = 0; a < tabla[i].length; a++) {
						if (tabla[a][i] > 0) {
							mayorCarreras = tabla[a][i];
							nombreCiudadMayor = ciudades[i];

						}
