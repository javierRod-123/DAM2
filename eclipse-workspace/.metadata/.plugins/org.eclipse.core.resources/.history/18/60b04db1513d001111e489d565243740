	protected void botonGuardarPulsado() {
		if (this.campoNombre.getText().isEmpty()) {
			this.error("Error");
		}
		
		String nombre = campoNombre.getText();
		
		int generacion = Integer.parseInt(campoNombre.getText());
		
		if (generacion < 1 || generacion > 7) {
			this.error("La generación debe ser entre 1 y 7");
		}
		
		String tipo = comboTipo.getSelectedItem().toString();
		
		String estadoEvolutivo = null;
		
		if (btnRadioMenor.isSelected()) {
			estadoEvolutivo = "Menor";
		} else if (btnRadioMedio.isSelected()) {
			estadoEvolutivo = "Medio";
		} else if (btnRadioMayor.isSelected()) {
			estadoEvolutivo = "Mayor";
		}
		
		Pokemon nuevoPokemon = new Pokemon(nombre, tipo, generacion, estadoEvolutivo);
		
		if (principal.guardaPokemon(nuevoPokemon)) {
			this.msg("Pokemon añadido");
		} else {
			this.error("El Pokemon ya existia");
		}
		
	}
	
