package colecciones;

import java.util.LinkedList;


public class Act3 {

	public static void main(String[] args) {
		LinkedList<Integer> menores = new LinkedList<Integer>();
		
		for(int i = 0; i < 20; i++) {
			int num = (int) Math.floor(Math.random()*(10+1)+0);
			int j = 0;
			while(j < menores.size() && menores.get(j) > num) {
				j++;
			}
			
			menores.add(j, num);
		}

	}

}
