<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de Formulario para rellenar los datos -->
    <record id="view_pedido_form" model="ir.ui.view">
        <field name="name">restaurante.pedido.form</field>
        <field name="model">restaurante.pedido</field>
        <field name="arch" type="xml">
            <form string="Pedido">
                <sheet>
                    <group>
                        <field name="ordernumber"/>
                        <field name="table"/>
                        <field name="waiter"/>
                        <field name="ordertime"/>
                        <field name="price"/>
                        <field name="productname"/>
                        <field name="state"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción y Menú para verlo en la pantalla de Odoo -->
    <record id="action_pedido" model="ir.actions.act_window">
        <field name="name">Pedidos</field>
        <field name="res_model">restaurante.pedido</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_restaurante_root" name="Restaurante"/>
    <menuitem id="menu_pedido" name="Pedidos" parent="menu_restaurante_root" action="action_pedido"/>
</odoo>